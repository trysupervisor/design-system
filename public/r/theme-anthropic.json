    "@import \"@fontsource-variable/public-sans\"": {},
    "@import \"@fontsource-variable/source-serif-4\"": {},
    "@import \"@fontsource-variable/geist-mono\"": {},
    ":root": {
      "--app-font": "\"Public Sans Variable\", \"Public Sans\", ui-sans-serif, system-ui, sans-serif",
      "--heading-font": "\"Source Serif 4 Variable\", \"Source Serif 4\", Georgia, serif",
      "--button-font": "\"Public Sans Variable\", \"Public Sans\", ui-sans-serif, system-ui, sans-serif",
      "--spacing": "0.25rem",
      "--input-radius": "0.5rem",
      "--button-radius": "0.5rem",
      "--button-weight": "400",
      "--border-width": "1px",
      "--panel-border-width": "0px",
      "--control-height": "2.25rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0",
      "--shadow-x": "0px",
      "--shadow-y": "0px",
      "--shadow-blur": "0px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 0px 0px 0px rgba(0, 0, 0, 0)"
    },
    ".dark": {
      "--app-font": "\"Public Sans Variable\", \"Public Sans\", ui-sans-serif, system-ui, sans-serif",
      "--heading-font": "\"Source Serif 4 Variable\", \"Source Serif 4\", Georgia, serif",
      "--button-font": "\"Public Sans Variable\", \"Public Sans\", ui-sans-serif, system-ui, sans-serif",
      "--spacing": "0.25rem",
      "--input-radius": "0.5rem",
      "--button-radius": "0.5rem",
      "--button-weight": "400",
      "--border-width": "1px",
      "--panel-border-width": "0px",
      "--control-height": "2.25rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0",
      "--shadow-x": "0px",
      "--shadow-y": "0px",
      "--shadow-blur": "0px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 0px 0px 0px rgba(0, 0, 0, 0)"
    }
  },
  "tailwind": {
    "config": {
      "theme": {
        "extend": {
          "fontFamily": {
            "sans": [
              "var(--app-font)"
            ],
            "heading": [
              "var(--heading-font)"
            ],
            "mono": [
              "Geist Mono Variable",
              "monospace"
            ]
          },
          "borderRadius": {
            "sm": "calc(var(--radius) * .6)",
            "md": "calc(var(--radius) * .8)",
            "lg": "var(--radius)",
            "xl": "calc(var(--radius) * 1.4)"
          },
          "spacing": {
            "1": "calc(var(--spacing) * 1)",
            "2": "calc(var(--spacing) * 2)",
            "3": "calc(var(--spacing) * 3)",
            "4": "calc(var(--spacing) * 4)",
            "5": "calc(var(--spacing) * 5)",
