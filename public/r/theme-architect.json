  "css": {
    "@import \"@fontsource-variable/ibm-plex-sans\"": {},
    "@import \"@fontsource-variable/geist-mono\"": {},
    ":root": {
      "--app-font": "\"IBM Plex Sans Variable\", \"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
      "--spacing": "0.22rem",
      "--border-width": "1.5px",
      "--control-height": "2rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0.12",
      "--shadow-x": "0px",
      "--shadow-y": "4px",
      "--shadow-blur": "12px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 4px 12px 0px rgba(0, 0, 0, 0.12)"
    },
    ".dark": {
      "--app-font": "\"IBM Plex Sans Variable\", \"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
      "--spacing": "0.22rem",
      "--border-width": "1.5px",
      "--control-height": "2rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0.12",
