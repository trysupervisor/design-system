      "--input-radius": "0.72rem",
      "--button-radius": "0.72rem",
      "--button-weight": "500",
      "--border-width": "1px",
      "--panel-border-width": "1px",
      "--control-height": "2rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0.12",
      "--shadow-x": "0px",
      "--shadow-y": "4px",
      "--shadow-blur": "12px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 4px 12px 0px rgba(0, 0, 0, 0.12)"
    },
    ".dark": {
      "--app-font": "\"Plus Jakarta Sans Variable\", \"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif",
      "--heading-font": "\"Plus Jakarta Sans Variable\", \"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif",
