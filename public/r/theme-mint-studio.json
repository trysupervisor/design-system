      "--shadow-y": "4px",
      "--shadow-blur": "12px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 4px 12px 0px rgba(0, 0, 0, 0.12)"
    }
  },
  "tailwind": {
    "config": {
      "theme": {
        "extend": {
          "fontFamily": {
            "sans": [
              "var(--app-font)"
            ],
            "heading": [
              "var(--heading-font)"
            ],
            "mono": [
