      "--control-height": "3rem",
      "--text-scale": "1",
      "--shadow-color": "#000000",
      "--shadow-opacity": "0",
      "--shadow-x": "0px",
      "--shadow-y": "0px",
      "--shadow-blur": "0px",
      "--shadow-spread": "0px",
