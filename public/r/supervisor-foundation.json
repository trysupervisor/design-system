{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "supervisor-foundation",
  "type": "registry:style",
  "title": "Supervisor foundation",
  "description": "Shared component rules for Supervisor themes.",
  "css": {
    "@layer base": {
      "html": {
        "--motion-control-duration": "150ms",
        "--motion-control-ease": "cubic-bezier(.4, 0, .2, 1)",
        "--motion-disclosure-duration": "200ms",
        "--motion-popover-duration": "200ms",
        "--motion-overlay-duration": "300ms",
        "--motion-swift-ease": "cubic-bezier(.175, .885, .32, 1.1)",
        "font-size": "calc(16px * var(--text-scale))",
        "color-scheme": "light"
      },
      "html.dark": {
        "color-scheme": "dark"
      },
      "body": {
        "margin": "0",
        "font-family": "var(--app-font)"
      },
      "button, input, textarea, select": {
        "font-family": "inherit"
      },
      "button:not(:disabled), [role=\"button\"]:not([aria-disabled=\"true\"])": {
        "cursor": "pointer"
      },
      ":focus-visible": {
        "outline-offset": "3px"
      }
    },
    ":is(h1, h2, h3, h4, h5, h6, [data-slot=\"card-title\"])": {
      "font-family": "var(--heading-font, var(--app-font))"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])": {
      "height": "var(--control-height)",
      "border-radius": "var(--button-radius, var(--radius))",
      "font-family": "var(--button-font, var(--app-font))",
      "font-weight": "var(--button-weight, 500)",
      "font-size": ".8125rem",
      "box-shadow": "var(--theme-shadow)"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])[data-size=\"sm\"], [data-slot=\"button\"][data-size=\"icon-sm\"]": {
      "height": "calc(var(--control-height) - 4px)"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])[data-size=\"xs\"], [data-slot=\"button\"][data-size=\"icon-xs\"]": {
      "height": "calc(var(--control-height) - 8px)"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])[data-size=\"lg\"], [data-slot=\"button\"][data-size=\"icon-lg\"]": {
      "height": "calc(var(--control-height) + 4px)"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])[data-size^=\"icon\"]": {
      "width": "var(--control-height)",
      "padding": "0"
    },
    "[data-slot=\"button\"][data-size=\"icon-sm\"]": {
      "width": "calc(var(--control-height) - 4px)"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"])[data-variant=\"outline\"]": {
      "border-width": "var(--border-width)"
    },
    "[data-slot=\"input\"], [data-slot=\"select-trigger\"], [data-slot=\"native-select\"]": {
      "height": "var(--control-height)",
      "border-radius": "var(--input-radius, var(--radius))",
      "border-width": "var(--border-width)",
      "font-size": ".8125rem"
    },
    "[data-slot=\"textarea\"], [data-slot=\"card\"], [data-slot=\"dialog-content\"], [data-slot=\"popover-content\"], [data-slot=\"combobox-content\"], [data-slot=\"dropdown-menu-content\"], [data-slot=\"select-content\"]": {
      "border-width": "var(--border-width)",
      "border-radius": "var(--radius)"
    },
    ":is([data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"input-group\"])": {
      "border-width": "max(1px, var(--border-width))",
      "border-radius": "var(--input-radius, var(--radius))",
      "transition-duration": "var(--motion-control-duration, 150ms)"
    },
    ":is([data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"input-group\"], [data-slot=\"select-trigger\"], [data-slot=\"native-select\"], select):focus-within": {
      "outline": "none",
      "box-shadow": "none"
    },
    ":is([data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"input-group\"], [data-slot=\"select-trigger\"], [data-slot=\"native-select\"], select):not([aria-invalid]:not([aria-invalid=\"false\"])):not(:has([aria-invalid]:not([aria-invalid=\"false\"]))):not([data-invalid]):not(:has([data-invalid])):focus-within": {
      "border-color": "currentColor",
      "box-shadow": "inset 0 0 0 1px currentColor"
    },
    "[data-slot=\"input-group-control\"]:focus": {
      "outline": "none",
      "box-shadow": "none"
    },
    "[data-slot=\"card\"]": {
      "border-width": "var(--panel-border-width, var(--border-width))",
      "box-shadow": "var(--theme-shadow)"
    },
    "[data-slot=\"badge\"]": {
      "border-radius": "calc(var(--radius) * .7)"
    },
    "[data-slot=\"table-head\"]": {
      "font-size": ".75rem",
      "font-weight": "500"
    },
    "[data-slot=\"table-cell\"]": {
      "font-size": ".8125rem"
    },
    ":is([data-slot=\"button\"], [data-slot=\"combobox-trigger\"], [data-slot=\"pagination-link\"], [data-slot=\"navigation-menu-trigger\"], [data-slot=\"navigation-menu-link\"])": {
      "transition-duration": "var(--motion-control-duration, 150ms)",
      "transition-timing-function": "var(--motion-control-ease, cubic-bezier(.4, 0, .2, 1))"
    },
    ":is([data-slot=\"breadcrumb-link\"], [data-slot=\"breadcrumb-page\"])": {
      "transition": "color 200ms"
    },
    ":is([data-slot=\"select-trigger\"], [data-slot=\"select-item\"])": {
      "transition-duration": "200ms"
    },
    ":is([data-slot=\"toggle\"], [data-slot=\"toggle-group-item\"])": {
      "transition-duration": "var(--motion-control-duration, 150ms)"
    },
    ":is([data-slot=\"dropdown-menu-trigger\"], [data-slot=\"menubar-trigger\"], [data-slot=\"navigation-menu-trigger\"]) > svg.lucide-chevron-down:last-child": {
      "transition": "rotate var(--motion-control-duration, 150ms) var(--motion-control-ease, cubic-bezier(.4, 0, .2, 1))"
    },
    ":is([data-slot=\"dropdown-menu-trigger\"], [data-slot=\"menubar-trigger\"], [data-slot=\"navigation-menu-trigger\"]):is([aria-expanded=\"true\"], [data-state=\"open\"], [data-open], [data-popup-open]) > svg.lucide-chevron-down:last-child": {
      "rotate": "180deg"
    },
    ":where([data-slot=\"dialog-overlay\"], [data-slot=\"alert-dialog-overlay\"]):is([data-state=\"open\"], [data-open])": {
      "animation": "supervisor-overlay-in var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":where([data-slot=\"dialog-overlay\"], [data-slot=\"alert-dialog-overlay\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-overlay-out var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":where([data-slot=\"dialog-content\"], [data-slot=\"alert-dialog-content\"])": {
      "transition": "opacity var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)), scale var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1))"
    },
    "[data-slot=\"dialog-content\"]": {
      "max-width": "min(540px, calc(100vw - 2rem))"
    },
    ":where([data-slot=\"dialog-content\"], [data-slot=\"alert-dialog-content\"]):is([data-state=\"open\"], [data-open])": {
      "animation": "supervisor-dialog-in var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":where([data-slot=\"dialog-content\"], [data-slot=\"alert-dialog-content\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-dialog-out var(--motion-overlay-duration, 300ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":where([data-slot=\"dialog-content\"], [data-slot=\"alert-dialog-content\"]):is([data-starting-style], [data-ending-style])": {
      "opacity": "0",
      "scale": ".96"
    },
    ":where([data-slot=\"sheet-overlay\"]):is([data-state=\"open\"], [data-open])": {
      "animation": "supervisor-overlay-in 200ms ease-in-out both"
    },
    ":where([data-slot=\"sheet-overlay\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-overlay-out 200ms ease-in-out both"
    },
    "[data-slot=\"sheet-content\"]": {
      "transition": "opacity 200ms ease-in-out, translate 200ms ease-in-out"
    },
    ":where([data-slot=\"sheet-content\"]):is([data-state=\"open\"], [data-open])": {
      "animation-duration": "200ms",
      "animation-fill-mode": "both",
      "animation-timing-function": "ease-in-out"
    },
    ":where([data-slot=\"sheet-content\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation-duration": "200ms",
      "animation-fill-mode": "both",
      "animation-timing-function": "ease-in-out"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"right\"]):is([data-state=\"open\"], [data-open])": {
      "animation-name": "supervisor-sheet-right-in"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"right\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation-name": "supervisor-sheet-right-out"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"left\"]):is([data-state=\"open\"], [data-open])": {
      "animation-name": "supervisor-sheet-left-in"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"left\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation-name": "supervisor-sheet-left-out"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"top\"]):is([data-state=\"open\"], [data-open])": {
      "animation-name": "supervisor-sheet-top-in"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"top\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation-name": "supervisor-sheet-top-out"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"bottom\"]):is([data-state=\"open\"], [data-open])": {
      "animation-name": "supervisor-sheet-bottom-in"
    },
    ":where([data-slot=\"sheet-content\"][data-side=\"bottom\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation-name": "supervisor-sheet-bottom-out"
    },
    "[data-slot=\"sheet-content\"][data-ending-style][data-side=\"right\"]": {
      "opacity": "0",
      "translate": "40px 0"
    },
    "[data-slot=\"sheet-content\"][data-starting-style][data-side=\"right\"]": {
      "opacity": "0",
      "translate": "20px 0"
    },
    "[data-slot=\"sheet-content\"][data-ending-style][data-side=\"left\"]": {
      "opacity": "0",
      "translate": "-40px 0"
    },
    "[data-slot=\"sheet-content\"][data-starting-style][data-side=\"left\"]": {
      "opacity": "0",
      "translate": "-20px 0"
    },
    "[data-slot=\"sheet-content\"][data-ending-style][data-side=\"top\"]": {
      "opacity": "0",
      "translate": "0 -40px"
    },
    "[data-slot=\"sheet-content\"][data-starting-style][data-side=\"top\"]": {
      "opacity": "0",
      "translate": "0 -20px"
    },
    "[data-slot=\"sheet-content\"][data-ending-style][data-side=\"bottom\"]": {
      "opacity": "0",
      "translate": "0 40px"
    },
    "[data-slot=\"sheet-content\"][data-starting-style][data-side=\"bottom\"]": {
      "opacity": "0",
      "translate": "0 20px"
    },
    ":where([data-slot=\"popover-content\"], [data-slot=\"combobox-content\"], [data-slot=\"hover-card-content\"]):is([data-state=\"open\"], [data-open])": {
      "animation": "none",
      "opacity": "1",
      "scale": "1",
      "translate": "none"
    },
    ":where([data-slot=\"popover-content\"], [data-slot=\"combobox-content\"], [data-slot=\"hover-card-content\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-popover-out var(--motion-popover-duration, 200ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":is([data-slot=\"popover-content\"], [data-slot=\"hover-card-content\"])[data-starting-style]": {
      "opacity": "1",
      "scale": "1",
      "translate": "none"
    },
    ":is([data-slot=\"popover-content\"], [data-slot=\"hover-card-content\"])[data-ending-style]": {
      "opacity": "0"
    },
    ":where([data-slot=\"dropdown-menu-content\"], [data-slot=\"dropdown-menu-sub-content\"], [data-slot=\"context-menu-content\"], [data-slot=\"context-menu-sub-content\"], [data-slot=\"menubar-content\"], [data-slot=\"menubar-sub-content\"]):is([data-state=\"open\"], [data-open])": {
      "animation": "none",
      "opacity": "1",
      "scale": "1",
      "translate": "none"
    },
    ":where([data-slot=\"dropdown-menu-content\"], [data-slot=\"dropdown-menu-sub-content\"], [data-slot=\"menubar-content\"], [data-slot=\"menubar-sub-content\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-menu-out 150ms ease-in-out both"
    },
    ":where([data-slot=\"context-menu-content\"], [data-slot=\"context-menu-sub-content\"]):is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-popover-out var(--motion-popover-duration, 200ms) var(--motion-swift-ease, cubic-bezier(.175, .885, .32, 1.1)) both"
    },
    ":is([data-slot=\"dropdown-menu-content\"], [data-slot=\"dropdown-menu-sub-content\"], [data-slot=\"context-menu-content\"], [data-slot=\"context-menu-sub-content\"], [data-slot=\"menubar-content\"], [data-slot=\"menubar-sub-content\"])[data-starting-style]": {
      "opacity": "1",
      "scale": "1",
      "translate": "none"
    },
    ":is([data-slot=\"dropdown-menu-content\"], [data-slot=\"dropdown-menu-sub-content\"], [data-slot=\"context-menu-content\"], [data-slot=\"context-menu-sub-content\"], [data-slot=\"menubar-content\"], [data-slot=\"menubar-sub-content\"])[data-ending-style]": {
      "opacity": "0"
    },
    "[data-slot=\"tooltip-content\"]:is([data-state=\"open\"], [data-state=\"delayed-open\"], [data-open])": {
      "animation": "supervisor-tooltip-in 100ms ease-in both"
    },
    "[data-slot=\"tooltip-content\"]:is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-overlay-out 100ms ease-in both"
    },
    "[data-slot=\"tooltip-content\"][data-starting-style], [data-slot=\"tooltip-content\"][data-ending-style]": {
      "opacity": "0"
    },
    ":is([data-slot=\"accordion-trigger\"] > [data-slot=\"accordion-trigger-icon\"], [data-slot=\"collapsible-trigger\"] > [data-slot=\"collapsible-trigger-icon\"], [data-slot=\"collapsible-trigger\"] > svg:last-child)": {
      "transition": "transform var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    ":is([data-slot=\"accordion-trigger\"]):is([aria-expanded=\"true\"], [data-state=\"open\"], [data-open]) > [data-slot=\"accordion-trigger-icon\"],\n:is([data-slot=\"collapsible-trigger\"]):is([aria-expanded=\"true\"], [data-state=\"open\"], [data-open]) > :is([data-slot=\"collapsible-trigger-icon\"], svg:last-child)": {
      "transform": "rotate(180deg)"
    },
    "[data-slot=\"accordion-trigger-icon\"]:has(+ [data-slot=\"accordion-trigger-icon\"])": {
      "display": "block !important"
    },
    "[data-slot=\"accordion-trigger-icon\"] + [data-slot=\"accordion-trigger-icon\"]": {
      "display": "none !important"
    },
    ":is([data-slot=\"accordion-content\"], [data-slot=\"collapsible-content\"])": {
      "height": "auto",
      "overflow": "hidden",
      "transition": "height var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    "[data-slot=\"accordion-content\"] > div": {
      "height": "auto"
    },
    "[data-slot=\"accordion-content\"]:is([data-state=\"open\"], [data-open])": {
      "animation": "supervisor-accordion-down var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    "[data-slot=\"accordion-content\"]:is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-accordion-up var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    "[data-slot=\"collapsible-content\"]:is([data-state=\"open\"], [data-open])": {
      "animation": "supervisor-collapsible-down var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    "[data-slot=\"collapsible-content\"]:is([data-state=\"closed\"], [data-closed])": {
      "animation": "supervisor-collapsible-up var(--motion-disclosure-duration, 200ms) ease-in-out"
    },
    ":is([data-slot=\"accordion-content\"], [data-slot=\"collapsible-content\"]):is([data-starting-style], [data-ending-style])": {
      "height": "0"
    },
    "[data-slot=\"switch\"]": {
      "transition": "background-color var(--motion-control-duration, 150ms) cubic-bezier(0, 0, .2, 1), border-color var(--motion-control-duration, 150ms) cubic-bezier(0, 0, .2, 1)"
    },
    "[data-slot=\"switch-thumb\"]": {
      "transition": "translate var(--motion-control-duration, 150ms) var(--motion-control-ease, cubic-bezier(.4, 0, .2, 1)), transform var(--motion-control-duration, 150ms) var(--motion-control-ease, cubic-bezier(.4, 0, .2, 1))"
    },
    ":is([data-slot=\"checkbox\"], [data-slot=\"radio-group-item\"])": {
      "transition": "border-color 200ms ease-in, background-color 200ms ease-in"
    },
    ":is([data-slot=\"checkbox-indicator\"], [data-slot=\"radio-group-indicator\"])": {
      "transform-origin": "center"
    },
    ":is([data-slot=\"checkbox\"], [data-slot=\"radio-group-item\"]):is([data-state=\"checked\"], [data-checked]) :is([data-slot=\"checkbox-indicator\"], [data-slot=\"radio-group-indicator\"])": {
      "animation": "supervisor-control-mark-in 150ms ease-in"
    },
    "[data-slot=\"progress-indicator\"]": {
      "transition": "width 100ms ease-in, transform 100ms ease-in, background-color 100ms ease-in"
    },
    "[data-slot=\"slider-thumb\"]": {
      "transition": "color 100ms, box-shadow 100ms, scale 100ms"
    },
    "[data-slot=\"slider-thumb\"]:is(:active, :focus-visible, [data-dragging])": {
      "scale": "1.2"
    },
    "[data-slot=\"skeleton\"]": {
      "position": "relative",
      "overflow": "hidden",
      "animation": "none"
    },
    "[data-slot=\"skeleton\"]::after": {
      "content": "\"\"",
      "position": "absolute",
      "inset": "0",
      "background": "linear-gradient(90deg, transparent, color-mix(in srgb, currentColor 8%, transparent), transparent)",
      "transform": "translateX(-100%)",
      "animation": "supervisor-skeleton-shimmer 1.5s ease-in-out infinite"
    },
    "[data-slot=\"spinner\"] [data-slot=\"spinner-segment\"]": {
      "transform-origin": "0 0",
      "animation": "supervisor-spinner-opacity 1s linear infinite",
      "animation-delay": "var(--spinner-delay)"
    },
    "[data-slot=\"tabs-trigger\"]::after": {
      "transition": "none"
    },
    "@keyframes supervisor-overlay-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes supervisor-overlay-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes supervisor-dialog-in": {
      "from": {
        "opacity": "0",
        "scale": ".96"
      },
      "to": {
        "opacity": "1",
        "scale": "1"
      }
    },
    "@keyframes supervisor-dialog-out": {
      "from": {
        "opacity": "1",
        "scale": "1"
      },
      "to": {
        "opacity": "0",
        "scale": ".96"
      }
    },
    "@keyframes supervisor-popover-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes supervisor-menu-out": {
      "from": {
        "opacity": "1"
      },
      "to": {
        "opacity": "0"
      }
    },
    "@keyframes supervisor-tooltip-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes supervisor-sheet-right-in": {
      "from": {
        "opacity": "0",
        "translate": "20px 0"
      },
      "to": {
        "opacity": "1",
        "translate": "0"
      }
    },
    "@keyframes supervisor-sheet-right-out": {
      "from": {
        "opacity": "1",
        "translate": "0"
      },
      "to": {
        "opacity": "0",
        "translate": "40px 0"
      }
    },
    "@keyframes supervisor-sheet-left-in": {
      "from": {
        "opacity": "0",
        "translate": "-20px 0"
      },
      "to": {
        "opacity": "1",
        "translate": "0"
      }
    },
    "@keyframes supervisor-sheet-left-out": {
      "from": {
        "opacity": "1",
        "translate": "0"
      },
      "to": {
        "opacity": "0",
        "translate": "-40px 0"
      }
    },
    "@keyframes supervisor-sheet-top-in": {
      "from": {
        "opacity": "0",
        "translate": "0 -20px"
      },
      "to": {
        "opacity": "1",
        "translate": "0"
      }
    },
    "@keyframes supervisor-sheet-top-out": {
      "from": {
        "opacity": "1",
        "translate": "0"
      },
      "to": {
        "opacity": "0",
        "translate": "0 -40px"
      }
    },
    "@keyframes supervisor-sheet-bottom-in": {
      "from": {
        "opacity": "0",
        "translate": "0 20px"
      },
      "to": {
        "opacity": "1",
        "translate": "0"
      }
    },
    "@keyframes supervisor-sheet-bottom-out": {
      "from": {
        "opacity": "1",
        "translate": "0"
      },
      "to": {
        "opacity": "0",
        "translate": "0 40px"
      }
    },
    "@keyframes supervisor-accordion-down": {
      "from": {
        "height": "0"
      },
      "to": {
        "height": "var(--radix-accordion-content-height, var(--accordion-panel-height))"
      }
    },
    "@keyframes supervisor-accordion-up": {
      "from": {
        "height": "var(--radix-accordion-content-height, var(--accordion-panel-height))"
      },
      "to": {
        "height": "0"
      }
    },
    "@keyframes supervisor-collapsible-down": {
      "from": {
        "height": "0"
      },
      "to": {
        "height": "var(--radix-collapsible-content-height, var(--collapsible-panel-height))"
      }
    },
    "@keyframes supervisor-collapsible-up": {
      "from": {
        "height": "var(--radix-collapsible-content-height, var(--collapsible-panel-height))"
      },
      "to": {
        "height": "0"
      }
    },
    "@keyframes supervisor-control-mark-in": {
      "from": {
        "opacity": "0",
        "scale": "0"
      },
      "to": {
        "opacity": "1",
        "scale": "1"
      }
    },
    "@keyframes supervisor-skeleton-shimmer": {
      "from": {
        "transform": "translateX(-100%)"
      },
      "to": {
        "transform": "translateX(100%)"
      }
    },
    "@keyframes supervisor-spinner-opacity": {
      "0%": {
        "opacity": ".2"
      },
      "20%": {
        "opacity": "1"
      },
      "100%": {
        "opacity": ".2"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      "*, *::before, *::after": {
        "animation-duration": ".01ms !important",
        "animation-iteration-count": "1 !important",
        "transition-duration": ".01ms !important",
        "scroll-behavior": "auto !important"
      }
    }
  },
