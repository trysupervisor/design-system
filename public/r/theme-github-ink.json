      "--input-radius": "0.375rem",
      "--button-radius": "0.375rem",
      "--button-weight": "500",
      "--border-width": "1px",
      "--panel-border-width": "1px",
      "--control-height": "2rem",
      "--text-scale": "1",
      "--shadow-color": "#1F2328",
      "--shadow-opacity": "0.04",
      "--shadow-x": "0px",
      "--shadow-y": "1px",
      "--shadow-blur": "1px",
      "--shadow-spread": "0px",
      "--theme-shadow": "0px 1px 1px 0px rgba(31, 35, 40, 0.04)"
    },
    ".dark": {
